{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {"value": "${AZURE_ENV_NAME}"},
    "location": {"value": "${AZURE_LOCATION}"},
    "tenantId": {"value": "${LAB_TENANT_ID}"},
    "apiClientId": {"value": "${LAB_API_CLIENT_ID}"},
    "apiClientSecret": {"value": "${LAB_API_CLIENT_SECRET}"},
    "apiImage": {
      "value": "${LAB_API_IMAGE}"
    },
    "apiRegistryMode": {"value": "${LAB_API_REGISTRY_MODE:-bootstrap}"}
  }
}
